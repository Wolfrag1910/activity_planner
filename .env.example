# Copy this file to .env and adjust. Never commit .env.
# Values for the Oracle server: docs/DEPLOY.md, step 5 (the table explains each one).

# A long random secret, different on your PC and on the server. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# true only while developing; always false on the server.
DJANGO_DEBUG=false

# Addresses the site answers on (comma-separated).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins allowed to submit forms, e.g. https://cumetria.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# true on the server (HTTPS), false locally (plain http).
DJANGO_HTTPS=false

# What Caddy serves. Locally ":80" (plain http). On the server: the domain name.
SITE_ADDRESS=:80

# Ports on your machine. Locally 8080 avoids clashing with anything on port 80;
# open http://localhost:8080. On the server use 80 and 443.
HTTP_PORT=8080
HTTPS_PORT=8443

# --- Google sign-in (optional locally) ---
# Without these, the "Continue with Google" button is hidden and only email links work.
# How to create them: docs/GOOGLE_SIGN_IN.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sending emails (sign-in links) ---
# Leave EMAIL_HOST empty locally: emails are then printed in the terminal
# (look in the `docker compose up` output for the link). Needed on the server.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Cumetria <cumetria@localhost>
