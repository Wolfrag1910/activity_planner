# Copy this file to .env and adjust. Never commit .env.

# A long random secret. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me

# true only while developing; always false on the server.
DJANGO_DEBUG=false

# Addresses the site answers on (comma-separated).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Full origins allowed to submit forms, e.g. https://cumetria.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# true on the server (HTTPS), false locally (plain http).
DJANGO_HTTPS=false

# What Caddy serves. Locally ":80" (plain http). On the server: the domain name.
SITE_ADDRESS=:80

# Ports on your machine. Locally 8080 avoids clashing with anything on port 80;
# open http://localhost:8080. On the server use 80 and 443.
HTTP_PORT=8080
HTTPS_PORT=8443
